# Google Gemini API Key
# Dapatkan API key gratis dari Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model AI Gemini:
# - gemini-flash-lite-latest (Selalu menggunakan versi Flash-Lite terbaru secara otomatis)
# - gemini-3.5-flash-lite (Versi spesifik Flash-Lite generasi 3.5)
GEMINI_MODEL=gemini-flash-lite-latest

# Firebase Admin SDK uses Application Default Credentials.
# Locally: gcloud auth application-default login
# App Hosting: the backend service account is used automatically.
FIREBASE_PROJECT_ID=pmbunipdu-d6a41
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# Optional named Firestore database; default is (default).
FIRESTORE_DATABASE_ID=(default)
# Optional canonical origin if your proxy rewrites the request host.
# APP_ORIGIN=https://your-domain.example

# SMTP Email Configuration (Pengiriman email konfirmasi nomor pendaftaran)
# Untuk Gmail: gunakan smtp.gmail.com, port 465 (secure) atau 587, dan 16-digit Google App Password.
# Untuk Webmail kampus: gunakan host mail domain kampus (misal: mail.unipdu.ac.id).
# Jika belum diisi, sistem berjalan dalam dev-mock mode (mencatat isi email ke console server).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pmb@unipdu.ac.id
SMTP_PASS=your-google-app-password
EMAIL_FROM="PMB UNIPDU <pmb@unipdu.ac.id>"
